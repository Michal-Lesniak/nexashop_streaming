{
  "name": "nexashop_m09_streaming_workflow",
  "email_notifications": {
    "on_failure": ["data-eng@nexashop.example.com"],
    "no_alert_for_skipped_runs": true
  },
  "tasks": [
    {
      "task_key": "bronze_orders",
      "notebook_task": {
        "notebook_path": "/Repos/nexashop_m09/bronze/bronze_orders_streaming"
      },
      "job_cluster_key": "streaming_cluster"
    },
    {
      "task_key": "bronze_clickstream",
      "notebook_task": {
        "notebook_path": "/Repos/nexashop_m09/bronze/bronze_clickstream_streaming"
      },
      "job_cluster_key": "streaming_cluster"
    },
    {
      "task_key": "silver_revenue",
      "depends_on": [{"task_key": "bronze_orders"}],
      "notebook_task": {
        "notebook_path": "/Repos/nexashop_m09/silver/silver_revenue_aggregations"
      },
      "job_cluster_key": "streaming_cluster"
    },
    {
      "task_key": "silver_funnel",
      "depends_on": [{"task_key": "bronze_clickstream"}],
      "notebook_task": {
        "notebook_path": "/Repos/nexashop_m09/silver/silver_funnel_analysis"
      },
      "job_cluster_key": "streaming_cluster"
    },
    {
      "task_key": "silver_attribution",
      "depends_on": [
        {"task_key": "bronze_orders"},
        {"task_key": "bronze_clickstream"}
      ],
      "notebook_task": {
        "notebook_path": "/Repos/nexashop_m09/silver/silver_attribution_join"
      },
      "job_cluster_key": "streaming_cluster"
    },
    {
      "task_key": "gold_abandoned_cart",
      "depends_on": [{"task_key": "bronze_clickstream"}],
      "notebook_task": {
        "notebook_path": "/Repos/nexashop_m09/gold/gold_abandoned_cart"
      },
      "job_cluster_key": "streaming_cluster"
    },
    {
      "task_key": "gold_fraud",
      "depends_on": [{"task_key": "bronze_orders"}],
      "notebook_task": {
        "notebook_path": "/Repos/nexashop_m09/gold/gold_fraud_detection"
      },
      "job_cluster_key": "streaming_cluster"
    },
    {
      "task_key": "metrics_listener",
      "notebook_task": {
        "notebook_path": "/Repos/nexashop_m09/gold/gold_streaming_metrics"
      },
      "job_cluster_key": "streaming_cluster"
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "streaming_cluster",
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id":   "Standard_DS3_v2",
        "num_workers":    2,
        "spark_conf": {
          "spark.databricks.delta.schema.autoMerge.enabled": "true"
        }
      }
    }
  ],
  "run_as": {"user_name": "data-eng@nexashop.example.com"},
  "max_concurrent_runs": 1
}
